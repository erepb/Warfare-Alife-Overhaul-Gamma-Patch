local ap_enabled = false

local function has_alifeplus()
    return ap_api ~= nil and ap_api.register_owner ~= nil
end

local function get_squad_base(squad)
    if squad.current_action ~= 1 then return nil end
    local smart_id = squad.current_target_id
    if not smart_id then return nil end
    local smart = alife_object(smart_id)
    if smart and smart.props and smart.props.base > 0 then return smart end
    return nil
end

local function is_lendable(squad)
    if is_squad_monster[squad.player_id] then return true end
    if squad.patrol_table then return true end
    if smart_terrain_warfare.random_patrols[squad.id] then return true end
    if squad.current_action ~= 1 then
        return false
    end
    local base = get_squad_base(squad)
    if not base then return true end
    if not smart_terrain_warfare.base_can_send(base) then
        warfare_log.trace("is_lendable: squad=%s NOT lendable (base %s cannot send)", tostring(squad.id), base:name())
        return false
    end
    return true
end

function is_ap_controlled(squad)
    if not ap_enabled then return false end
    if not squad then
        warfare_log.warn("is_ap_controlled: nil squad")
        return false
    end
    if not ap_api.get_scripted_squad then return false end
    return ap_api.get_scripted_squad(squad.id) ~= nil
end

function log_ap_controlled(squad, caller)
    if not squad then
        warfare_log.warn("log_ap_controlled: nil squad (caller=%s)", tostring(caller))
        return
    end
    local target_name = squad.scripted_target or "?"
    local pretty = smart_terrain_warfare.translate_smart_name(target_name) or target_name
    warfare_log.trace("log_ap_controlled: squad=%s caller=%s target=%s", tostring(squad.id), tostring(caller), tostring(pretty))
end

-- Release a squad from AlifePlus scripted control so warfare can take it over.
-- Inert when AlifePlus is absent (is_ap_controlled returns false). Returns true if a
-- release was actually performed.
function reclaim_from_ap(squad)
    if not is_ap_controlled(squad) then
        warfare_log.debug("reclaim_from_ap: squad=%s not AP-controlled, nothing to reclaim", tostring(squad and squad.id))
        return false
    end
    if type(ap_core_broker.release_squad) ~= "function" then
        warfare_log.warn("reclaim_from_ap: AlifePlus present but release_squad unavailable; cannot reclaim squad=%s", tostring(squad.id))
        return false
    end
    local ok = ap_core_broker.release_squad(squad.id)
    warfare_log.info("reclaim_from_ap: squad=%s released from AlifePlus control (result=%s)", tostring(squad.id), tostring(ok))
    return ok
end

local function _other_label(record)
    local who = record.other_name
    if (not who or who == "") and record.other_species_key and ap_api.get_text then
        who = ap_api.get_text(record.other_species_key)
    end
    local fac
    if record.other_faction_key and ap_api.get_text then
        fac = ap_api.get_text(record.other_faction_key)
    end
    if who and who ~= "" then
        if fac and fac ~= "" then return who .. " (" .. fac .. ")" end
        return who
    end
    if fac and fac ~= "" then return fac end
    return nil
end

function get_ap_status(squad)
    if not ap_enabled then return nil end
    if not (ap_api.get_scripted_squad and ap_api.get_record) then return nil end
    if not ap_api.get_scripted_squad(squad.id) then return nil end
    warfare_log.debug("get_ap_status: squad=%s", tostring(squad.id))
    local record = ap_api.get_record({ squad_id = squad.id, assigned = true })
    if not record then
        warfare_log.debug("get_ap_status: no record for squad=%s", tostring(squad.id))
        return game.translate_string("st_wrfr_ap_unknown")
    end

    local action
    if record.action_key and ap_api.get_text then
        local translated = ap_api.get_text(record.action_key)
        if translated and translated ~= "" and translated ~= record.action_key then action = translated end
    end
    if not action then action = game.translate_string("st_wrfr_ap_unknown") end

    local other = _other_label(record)
    if other then action = action .. " - " .. other end

    local lines = { action }

    if record.smart_id then
        local smart = alife_object(record.smart_id)
        if smart then
            local sname = smart_terrain_warfare.translate_smart_name(smart:name()) or smart:name()
            lines[#lines + 1] = game.translate_string("st_wrfr_prop_target") .. ": " .. sname
        end
    end

    if record.level_id then
        local lvl_key = alife():level_name(record.level_id)
        if lvl_key then
            local lvl = game.translate_string(lvl_key)
            if lvl and lvl ~= "" then
                lines[#lines + 1] = game.translate_string("st_wrfr_sim_12") .. ": " .. lvl
            end
        end
    end

    return table.concat(lines, " \\n  \\n ")
end

function on_game_start()
    if not has_alifeplus() then
        warfare_log.info("warfare_alifeplus: AlifePlus not present, interop disabled")
        return
    end
    ap_enabled = true
    warfare_log.info("warfare_alifeplus: AlifePlus detected, registering owner handler")

    ap_api.register_owner("warfare", function(squad)
        if not squad then return false end
        if squad.registered_with_warfare ~= true then return false end
        return not is_lendable(squad)
    end)

    RegisterScriptCallback("on_game_load", function()
        local count = 0
        for faction, squads in pairs(warfare.registered_squads) do
            for sid in pairs(squads) do
                local squad = alife_object(sid)
                if squad and squad.scripted_target == "" then
                    squad.scripted_target = nil
                    count = count + 1
                end
            end
        end
        if count > 0 then
            warfare_log.info("warfare_alifeplus: on_game_load cleared empty-string scripted_target on %s squads", tostring(count))
        end
    end)

end

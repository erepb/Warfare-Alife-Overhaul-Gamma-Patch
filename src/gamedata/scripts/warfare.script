squad_community_by_behaviour["trader"] = "trader"

warfare_debug = false
dbg_all_faction_tooltips = false  -- debug: show full own-faction tooltip info for all squads and smarts

actor_faction = nil
actor_influence_points = 0
influence_levels = {} -- influence_levels[smart_terrain_id] = influence_level if > 0 or nil

base_count = 0
resource_count = 0
level_count = 32
initialized = false

-- Tracks the game time at the last warfare update for delta computation
local last_warfare_time = nil

-- Night spawn pause system
-- Tracks accumulated night seconds so spawn timers can be corrected at dawn
local was_night_wt = false          -- was it night hours on last tick?
night_accumulated = 0                -- game seconds accumulated during current night period

-- Called by spawn functions to check if spawning is blocked (night hours)
function is_spawn_blocked()
    return warfare_utils.is_night()
end

-- Legacy shim. Vanilla signature: `printd(e, optionalMessage)` — an entry/exit
-- marker where e==0 means "start" and any other e is an end-tag value. Several
-- vanilla scripts capture `printd = warfare.printd` at file load time
-- (pda_actor.script, dialogs.script, etc.); without this stub the capture
-- resolves to nil and the first call crashes. Forwards to warfare_log.debug;
-- the level filter still applies (silent unless log_level >= debug).
function printd(e, optionalMessage)
    if not warfare_log.enabled() then return end
    local info = debug.getinfo(2, "nS")
    local src = (info and info.short_src) or "?"
    local name = (info and info.name) or "?"
    local line = (debug.getinfo(2) and debug.getinfo(2).currentline) or "?"
    local marker = (e == 0) and "start" or ("end " .. tostring(e))
    if optionalMessage then
        warfare_log.debug("%s || %s || line: %s || %s %s", src, name, line, marker, optionalMessage)
    else
        warfare_log.debug("%s || %s || line: %s || %s", src, name, line, marker)
    end
end

-- Thin wrappers over game.get_game_time() kept to avoid touching 70+ call sites.
-- No performance cost worth caring about; provides a hook point if warfare
-- ever needs its own clock again.
function get_time()
    return game.get_game_time()
end

function get_time_ref()
    return game.get_game_time()
end

-- Variable to see if all_out_war was applied at the start of a new game (maintain compatibility with dynamic relations)
all_out_war_applied = false

-- Variable to see if all_out_war was applied after loading a save.
need_all_out_war_applied = true
dynamic_relations_installed = false

-- Special squads to ignore in offline combat and to ignore when assigning targets
ignore = {}

function apply_all_out_war()
    warfare_log.info("apply_all_out_war: setting all faction relations to -4000 (actor_faction=%s)", actor_faction)
    for i, faction in pairs(warfare_factions.factions) do
        for j, faction2 in pairs(warfare_factions.factions) do
            if (faction ~= faction2) then
                warfare_log.trace("apply_all_out_war: %s vs %s", faction, faction2)
                game_relations.set_factions_community(faction, faction2, -4000)

                if (dynamic_relations_installed) then
                    save_var(db.actor, ("drx_df_" .. faction .. "_" .. faction2 .. "_relations"), -4000)
                    save_var(db.actor, ("drx_df_" .. faction2 .. "_" .. faction .. "_relations"), -4000)
                end

                if (actor_faction == faction) then
                    game_relations.set_factions_community("actor_" .. faction, faction2, -4000)
                elseif (actor_faction == faction2) then
                    game_relations.set_factions_community(faction, "actor_" .. faction2, -4000)
                end
            end
        end
    end
end

-- table for registered squad ids
registered_squads = {
    stalker = {},
    bandit = {},
    csky = {},
    army = {},
    freedom = {},
    dolg = {},
    ecolog = {},
    killer = {},
    monolith = {},
    renegade = {},
    greh = {},
    isg = {},
    monster = {},
    zombied = {},
}

-- Remove a registered squad id from both the live table and the persistent save
-- buffer. Without the m_data purge, stale entries survive across saves and get
-- restored as ghosts on the next load.
function remove_registered_squad(faction, id)
    if not (faction and id) then
        warfare_log.warn("remove_registered_squad: nil args faction=%s id=%s", faction, id)
        return
    end
    warfare_log.trace("remove_registered_squad: faction=%s id=%s", faction, id)
    if registered_squads[faction] then
        registered_squads[faction][id] = nil
    end
    local mdata = alife_storage_manager and alife_storage_manager.get_state and alife_storage_manager.get_state()
    if mdata and mdata.warfare and mdata.warfare.squads and mdata.warfare.squads[faction] then
        mdata.warfare.squads[faction][id] = nil
    end
end

function actor_on_first_update()
    warfare_log.tr_begin("warfare/actor_on_first_update")
    if not (IsWarfare()) then
        if (_G.WARFARE) then
            warfare_log.info("actor_on_first_update: IsWarfare() returned false, disabling _G.WARFARE")
            _G.WARFARE = false
        end
        return
    end

    warfare_log.info("actor_on_first_update: scanning registered_squads for ghosts")
    local removed = {}
    for faction, tbl in pairs(registered_squads) do
        for id in pairs(tbl) do
            local obj = alife_object(id)
            local reason
            if not obj then
                reason = "no_alife"
            elseif type(obj.clsid) ~= "function" or obj:clsid() ~= clsid.online_offline_group_s then
                reason = "not_squad"
            elseif type(obj.get_squad_community) ~= "function" or obj:get_squad_community() ~= faction then
                local actual = (type(obj.get_squad_community) == "function") and tostring(obj:get_squad_community()) or "<no method>"
                reason = "faction_mismatch:" .. actual
            end
            if reason then
                warfare_log.debug("actor_on_first_update: ghost faction=%s id=%s reason=%s", faction, id, reason)
                removed[#removed + 1] = { faction = faction, id = id, reason = reason }
            end
        end
    end
    warfare_log.info("actor_on_first_update: %s ghosts found, purging", #removed)
    for _, e in ipairs(removed) do
        remove_registered_squad(e.faction, e.id)
    end

    warfare_log.info("actor_on_first_update: initializing warfare level data")
    actor_faction = get_actor_true_community() or alife():actor():community():sub(7)
    warfare_log.info("actor_on_first_update: actor_faction=%s", actor_faction)
    give_info("actor_made_wish_for_peace")

    if (warfare_options.options.all_out_war) then
        warfare_log.info("actor_on_first_update: all_out_war enabled, setting -5000 relations")
        for i, f in pairs(warfare_factions.factions) do
            for j, f2 in pairs(warfare_factions.factions) do
                if f ~= f2 then
                    game_relations.set_factions_community_num(f, f2, -5000)
                end
            end
        end
    end

    warfare_log.debug("actor_on_first_update: scanning SIMBOARD.smarts_by_names to populate level_information")
    local bootstrapped = 0
    for name, smart in pairs(SIMBOARD.smarts_by_names) do
        -- Eagerly bootstrap before the alife scheduler gets to it, so the
        -- warfare_levels/warfare_factions aggregation below sees populated
        -- owning_faction state. Otherwise smart_terrain_on_update fires per
        -- smart on the seqParallel worker in batches and most owning_faction
        -- reads return nil, collapsing fi.base_count to 0 and triggering a
        -- spurious emergency_resurrection_spawn.
        if not smart.first_update then
            smart_terrain_warfare.bootstrap_smart(smart)
            bootstrapped = bootstrapped + 1
        end

        if (not smart.level_id) then
            smart.level_id = game_graph():vertex(smart.m_game_vertex_id):level_id()
        end

        if (not warfare_levels.level_information[smart.level_id]) then
            warfare_log.trace("actor_on_first_update: init level_information[%s]", smart.level_id)
            warfare_levels.level_information[smart.level_id] = {}
            warfare_levels.level_information[smart.level_id].smarts = {}
            warfare_levels.level_information[smart.level_id].faction_priority = {}
            warfare_levels.level_information[smart.level_id].base_count = 0
            warfare_levels.level_information[smart.level_id].resource_count = 0
            warfare_levels.level_information[smart.level_id].territory_count = 0
            warfare_levels.level_information[smart.level_id].lair_count = 0
            warfare_levels.level_information[smart.level_id].first_update = true
        end

        if (smart.props) then
            table.insert(warfare_levels.level_information[smart.level_id].smarts, smart.id)

            if smart.props then

                -- Count the total number of smart terrain types in the level; will be used in level analysis
                if smart.props.base > 0 then
                    warfare_levels.level_information[smart.level_id].base_count = warfare_levels.level_information[smart.level_id].base_count + 1
                    base_count = base_count + 1
                elseif smart.props.territory > 0 then
                    warfare_levels.level_information[smart.level_id].territory_count = warfare_levels.level_information[smart.level_id].territory_count + 1
                end

                if smart.props.resource > 0 then
                    warfare_levels.level_information[smart.level_id].resource_count = warfare_levels.level_information[smart.level_id].resource_count + 1
                    resource_count = resource_count + smart.props.resource
                end

                if smart.props.lair > 0 then
                    warfare_levels.level_information[smart.level_id].lair_count = warfare_levels.level_information[smart.level_id].lair_count + 1
                end

                -- Cycle through factions
                for i, f in pairs(warfare_factions.factions) do
                    -- check if smart is flagged for faction
                    if smart.props[f] and smart.props[f] > 0 then
                        if not warfare_levels.level_information[smart.level_id].faction_priority[f] then
                            warfare_levels.level_information[smart.level_id].faction_priority[f] = 0
                        end

                        warfare_levels.level_information[smart.level_id].faction_priority[f] = warfare_levels.level_information[smart.level_id]["faction_priority"][f] + smart.props[f]
                    end
                end
            end
        end
    end
    warfare_log.info("actor_on_first_update: bootstrapped %s smarts before level/faction aggregation", tostring(bootstrapped))
end

-- save warfare state
function save_state(m_data)
    warfare_log.info("save_state: persisting warfare state")

    -- if data doesn't exist, create it.
    if (not m_data.warfare) then
        warfare_log.debug("save_state: m_data.warfare missing, initializing fresh")
        m_data.warfare = {}
        m_data.warfare.squads = {}
        m_data.warfare.smart_owners = {}
    end

    m_data.warfare.actor_influence_points = actor_influence_points
    m_data.warfare.influence_levels = influence_levels
    m_data.warfare.all_out_war_applied = all_out_war_applied
    m_data.warfare.night_accumulated = night_accumulated
    m_data.warfare.was_night_wt = was_night_wt
    m_data.warfare.manual_control = pda_actor.manual_control
    m_data.warfare.manual_point = smart_terrain_warfare.manual_point
    m_data.warfare.invasions = smart_terrain_warfare.invasions
    m_data.warfare.player_heli = warfare_faction_control.player_heli
    m_data.warfare.defense_timers = smart_terrain_warfare.defense_timers
    m_data.warfare.defense_delay = smart_terrain_warfare.defense_delay
    m_data.warfare.patrol_timers = smart_terrain_warfare.patrol_timers

    m_data.warfare.patrol_squads = smart_terrain_warfare.patrol_squads
    m_data.warfare.faction_information = warfare_factions.faction_information
    m_data.warfare.new_surge = new_surge or true

    m_data.warfare.spawn_mutant_timers = smart_terrain_warfare.spawn_mutant_timers
    m_data.warfare.spawn_mutant_next_update = smart_terrain_warfare.spawn_mutant_next_update
    m_data.warfare.process_mutant_timers = smart_terrain_warfare.process_mutant_timers
    m_data.warfare.process_mutant_next_update = smart_terrain_warfare.process_mutant_next_update
    m_data.warfare.loner_timer = smart_terrain_warfare.loner_timer
    m_data.warfare.loners_next_update = smart_terrain_warfare.loners_next_update
    m_data.warfare.ecolog_timer = smart_terrain_warfare.ecolog_timer
    m_data.warfare.ecolog_next_update = smart_terrain_warfare.ecolog_next_update
    m_data.warfare.smart_terrain_distances = smart_terrain_warfare.smart_terrain_distances
    m_data.warfare.under_attack = smart_terrain_warfare.under_attack

    for sid, _ in pairs(smart_terrain_warfare.random_patrols) do
        local squad = sid and alife_object(sid)

        if (squad) then
            -- empty squads and loner/ecolog squads are unmarked
            if (not squad.npc_count or squad:npc_count() == 0) then
                warfare_log.debug("save_state: dropping empty random_patrol sid=%s", sid)
                smart_terrain_warfare.remove_random_patrol(sid)
            end
        end
    end

    m_data.warfare.random_patrols = smart_terrain_warfare.random_patrols

    -- iterate over the faction tables in registered_squads
    local squad_total = 0
    for faction, tbl in pairs(registered_squads) do
        if not m_data.warfare.squads[faction] then
            m_data.warfare.squads[faction] = {}
        end

        -- iterate over the squad ids in the faction table
        for ID, target in pairs(tbl) do
            m_data.warfare.squads[faction][ID] = target
            squad_total = squad_total + 1
        end
    end

    for name, smart in pairs(SIMBOARD.smarts_by_names) do
        m_data.warfare.smart_owners[smart.id] = smart.owning_faction
    end

    warfare_squad_command.save_state(m_data.warfare)

    warfare_log.info("save_state: persisted %s registered squads", squad_total)
end

loaded_squads = false
legacy_save_stagger = false  -- set true when loading a save that has no persisted defense/patrol timers

function load_state(m_data)
    -- if warfare data isn't saved, return early.
    warfare_log.info("load_state: restoring warfare state (m_data.warfare=%s)", m_data.warfare ~= nil)


    actor_influence_points = m_data.warfare and m_data.warfare.actor_influence_points or 0
    influence_levels = m_data.warfare and m_data.warfare.influence_levels or {}
    all_out_war_applied = m_data.warfare and m_data.warfare.all_out_war_applied or false
    night_accumulated = m_data.warfare and m_data.warfare.night_accumulated or 0
    was_night_wt = m_data.warfare and m_data.warfare.was_night_wt or false
    pda_actor.manual_control = m_data.warfare and m_data.warfare.manual_control or false
    smart_terrain_warfare.manual_point = m_data.warfare and m_data.warfare.manual_point


    smart_terrain_warfare.invasions = m_data.warfare and m_data.warfare.invasions or {}
    warfare_faction_control.player_heli = m_data.warfare and m_data.warfare.player_heli

    -- Detect legacy save (pre-1.4.5): defense_delay was introduced after 1.4.2.
    -- Old saves have warfare data but no defense_delay key.
    legacy_save_stagger = m_data.warfare ~= nil and m_data.warfare.defense_delay == nil
    if legacy_save_stagger then
        warfare_log.warn("load_state: legacy save detected (no defense_delay) - will stagger spawn timers")
    end

    smart_terrain_warfare.defense_timers = m_data.warfare and m_data.warfare.defense_timers or {}
    smart_terrain_warfare.defense_delay = m_data.warfare and m_data.warfare.defense_delay or {}
    smart_terrain_warfare.patrol_timers = m_data.warfare and m_data.warfare.patrol_timers  or {}
    smart_terrain_warfare.patrol_squads = m_data.warfare and m_data.warfare.patrol_squads or {}
    smart_terrain_warfare.random_patrols = m_data.warfare and m_data.warfare.random_patrols or {}
    smart_terrain_warfare.random_patrol_counts = {}
    for _, f in pairs(smart_terrain_warfare.random_patrols) do
        smart_terrain_warfare.random_patrol_counts[f] = (smart_terrain_warfare.random_patrol_counts[f] or 0) + 1
    end

    smart_terrain_warfare.spawn_mutant_timers = m_data.warfare and m_data.warfare.spawn_mutant_timers or {}
    smart_terrain_warfare.spawn_mutant_next_update = m_data.warfare and m_data.warfare.spawn_mutant_next_update or {}
    smart_terrain_warfare.process_mutant_timers = m_data.warfare and m_data.warfare.process_mutant_timers or {}
    smart_terrain_warfare.process_mutant_next_update = m_data.warfare and m_data.warfare.process_mutant_next_update or {}

    -- Clamp saved mutant timer durations to current option max so setting reductions take effect immediately
    local _max_mutant = warfare_options.options.monster_max_faction_respawn
    warfare_log.debug("load_state: clamping mutant timers to max=%s", _max_mutant)
    for id, v in pairs(smart_terrain_warfare.spawn_mutant_next_update) do
        if v > _max_mutant then
            warfare_log.trace("load_state: clamp spawn_mutant_next_update[%s] %s->%s", id, v, _max_mutant)
            smart_terrain_warfare.spawn_mutant_next_update[id] = _max_mutant
        end
    end
    for id, v in pairs(smart_terrain_warfare.process_mutant_next_update) do
        if v > _max_mutant then
            warfare_log.trace("load_state: clamp process_mutant_next_update[%s] %s->%s", id, v, _max_mutant)
            smart_terrain_warfare.process_mutant_next_update[id] = _max_mutant
        end
    end
    smart_terrain_warfare.loner_timer = m_data.warfare and m_data.warfare.loner_timer or {}
    smart_terrain_warfare.loners_next_update = m_data.warfare and m_data.warfare.loners_next_update or {}
    smart_terrain_warfare.ecolog_timer = m_data.warfare and m_data.warfare.ecolog_timer or {}
    smart_terrain_warfare.ecolog_next_update = m_data.warfare and m_data.warfare.ecolog_next_update or {}
    smart_terrain_warfare.smart_terrain_distances = m_data.warfare and m_data.warfare.smart_terrain_distances or {}
    smart_terrain_warfare.under_attack = m_data.warfare and m_data.warfare.under_attack or {}

    new_surge = m_data.warfare and m_data.warfare.new_surge or true


    for smart, squads in pairs(m_data.warfare and m_data.warfare.patrol_squads or {}) do
        for squad_id, tbl in pairs(squads) do
            if type(tbl) == "number" then
                warfare_log.debug("load_state: migrating legacy patrol_squads entry smart=%s squad=%s", smart, squad_id)
                smart_terrain_warfare.patrol_squads[smart][squad_id] = {
                    target = tbl,
                    arrive_time = nil,
                    stay_time = nil
                }
            end
        end
    end


    warfare_factions.faction_information = m_data.warfare and m_data.warfare.faction_information or {}

    local restored = 0
    local purged = 0
    local ign = sim_offline_combat.get_ignore_list()
    local to_purge = {}
    for faction, tbl in pairs(m_data.warfare and m_data.warfare.squads or {}) do
        for ID, target in pairs(tbl) do
            local se = alife_object(ID)
            if se and ign[se:section_name()] then
                -- Don't restore stale registrations of ignore-listed story squads.
                to_purge[#to_purge + 1] = { faction, ID }
                purged = purged + 1
            else
                registered_squads[faction][ID] = target
                loaded_squads = true
                restored = restored + 1
            end
        end
    end
    -- Drop the stale entries from the persisted table too,
    -- so the save is healed permanently rather than re-skipped each load.
    for i = 1, #to_purge do
        local fp = to_purge[i]
        if m_data.warfare.squads[fp[1]] then
            m_data.warfare.squads[fp[1]][fp[2]] = nil
        end
    end
    warfare_log.info("load_state: restored %s registered squads (purged %s stale ignore-listed)", restored, purged)


    if (m_data.warfare and m_data.warfare.smart_owners) then
        for smart, faction in pairs(m_data.warfare and m_data.warfare.smart_owners or {}) do
            smart_terrain_warfare.smart_owners[smart] = faction
        end
    end


    if (m_data.warfare and m_data.warfare.point_cap_timers) then
        for smart, timer in pairs(m_data.warfare and m_data.warfare.point_cap_timers or {}) do
            smart_terrain_warfare.point_cap_timers[smart] = timer
        end
    end


    warfare_squad_command.load_state(m_data.warfare)

    -- clear old data.
    m_data.warfare = nil
    warfare_log.debug("load_state: complete, m_data.warfare cleared")
end

-- callback for when npcs are created for a squad, done in create_squad for sim_board.
function squad_on_npc_creation(squad, se_obj, spawn_smart)
    warfare_log.trace("squad_on_npc_creation: squad=%s smart=%s", squad and squad:name(), spawn_smart and spawn_smart:name())

    -- Ignore any squads in the ignore list.
    if not (ignore[squad:section_name()]) then
        if (not squad.registered_with_warfare) then

            -- get the squads faction
            local faction = squad:get_squad_community()

            if (registered_squads[faction]) then
                warfare_log.debug("squad_on_npc_creation: registering squad=%s faction=%s smart=%s", squad:name(), faction, spawn_smart:name())
                registered_squads[faction][squad.id] = spawn_smart.id
                squad.assigned_target_id = spawn_smart.id
                squad.registered_with_warfare = true
                spawn_smart:on_reach_target(squad)
            else
                warfare_log.trace("squad_on_npc_creation: faction %s not in registered_squads table", faction)
            end
        else
        end
    else
        warfare_log.trace("squad_on_npc_creation: ignored section=%s", squad:section_name())
    end

end

-- last update time
local last_update

local new_surge = true
local old_surge_cnt

-- callback for the actors update method
function actor_on_update()
    warfare_log.tr_begin("warfare/actor_on_update")
    warfare_log.debug("actor_on_update")

    if not _G.WARFARE then
        return
    end

    -- get the current game time
    local tg = game.get_game_time()

    -- if last update time doesn't exist, set it.
    if (not last_update) then
        last_update = warfare_utils.add_time(tg, 60)
    end

    if (last_update:diffSec(tg) > 0) then
        warfare_log.trace("actor_on_update: throttled, awaiting tick")
        return
    end

    warfare_log.trace("actor_on_update: tick fired")

    -- Time delta tracking for spawn protection
    if not last_warfare_time then
        last_warfare_time = tg
    end
    warfare_utils.refresh_time_cache()

    local time_delta = tg:diffSec(last_warfare_time)

    if time_delta > 0 then
        local old_wt = last_warfare_time
        local instant_big_jump = false

        -- Big time jump (>1 hour): advance spawn timers to prevent mass spawns
        if time_delta > 3600 then
            warfare_log.info("actor_on_update: big time jump %s sec - advancing spawn timers", time_delta)
            smart_terrain_warfare.advance_spawn_timers(time_delta)
            warfare_factions.advance_spawn_timers(time_delta)
            instant_big_jump = true
        end

        last_warfare_time = tg

        -- Night time correction
        if instant_big_jump then
            night_accumulated = 0
            warfare_utils.refresh_time_cache()
            was_night_wt = warfare_utils.is_night()
        else
            local night_secs = warfare_utils.compute_night_seconds(old_wt, time_delta)
            night_accumulated = night_accumulated + night_secs

            warfare_utils.refresh_time_cache()
            local new_is_night = warfare_utils.is_night()

            if not new_is_night and night_accumulated > 0 then
                warfare_log.info("actor_on_update: dawn reached, advancing spawn timers by %s night-sec", night_accumulated)
                smart_terrain_warfare.advance_spawn_timers(night_accumulated)
                warfare_factions.advance_spawn_timers(night_accumulated)
                night_accumulated = 0
            end
            if new_is_night ~= was_night_wt then
                warfare_log.debug("actor_on_update: night state change %s->%s", was_night_wt, new_is_night)
            end
            was_night_wt = new_is_night
        end
    end

    last_update = warfare_utils.add_time(tg, 60)

    -- Update faction to account for switching factions or azazel mode.
    --printf("!!!! "..alife_storage_manager.get_state().default_faction.." !!!!" )
    actor_faction = get_actor_true_community() or alife():actor():community():sub(7)

    if (not initialized) then
        warfare_log.info("actor_on_update: not initialized, running one-shot init")
        if ui_options.get("alife/general/dynamic_relations") then
            dynamic_relations_installed = true
            warfare_log.info("actor_on_update: dynamic_relations detected")
        end

        if (dynamic_relations_installed) then
            if (not all_out_war_applied and warfare_options.options.all_out_war) then
                apply_all_out_war()
                all_out_war_applied = true
            end
        elseif (warfare_options.options.all_out_war) then
            apply_all_out_war()
        end

        initialize()
        warfare_levels.update()
        smart_terrain_warfare.build_smart_collections()
        warfare_factions.update()
    end

    warfare_levels.update()
    warfare_factions.update()

    local new_surge_cnt = game_statistics.actor_statistics["emissions"].count or 0
    if (not old_surge_cnt) then
        old_surge_cnt = new_surge_cnt
    end
    if (new_surge_cnt > old_surge_cnt) then
        warfare_log.info("actor_on_update: emission count %s->%s, triggering snap()", old_surge_cnt, new_surge_cnt)
        snap()
    end
    old_surge_cnt = new_surge_cnt

    --[[
    local sg = surge_manager.get_surge_manager()
    if (sg.started) then
        if (new_surge) then
            local t = sg.inited_time
            local diff_sec = math.ceil(game.get_game_time():diffSec(t)/level.get_time_factor())

            if (diff_sec >= 170) then
                new_surge = false
                snap()
            end
        end
    else
        new_surge = true
    end
    --]]

end

function initialize()
    warfare_log.info("initialize: warfare initialized")

    -- At this point this just serves to pause everything to ensure squads reach their "waiting at target" state before resource counts etc are calculated.
    initialized = true

    --[[for lvl,tbl in pairs(warfare_levels.level_information) do
        for f,p in pairs(tbl["faction_priority"]) do
            ----printf(game.translate_string(alife():level_name(lvl)) .. " priority for " .. game.translate_string(f) .. " = " .. p)
        end
    end]]
end

warfare_positions_filled = false

FACTION_TERRITORY_RADIUS = 100

function shuffleTable(t)
    local rand = math.random
    local iterations = #t
    local j

    for i = iterations, 2, -1 do
        j = rand(i)
        t[i], t[j] = t[j], t[i]
    end
end

function get_stalker_pop_factor_value()
    return ui_options.get("alife/general/alife_stalker_pop")
end

-- Cached pop factors -- refreshed each warfare update cycle via refresh_pop_cache()
local cached_stalker_pop = nil
local cached_monster_pop = nil
pop_dirty = true  -- signals set_max_population to recalculate (exposed for smart_terrain_warfare)

function refresh_pop_cache()
    local new_stalker = get_stalker_pop_factor_value()
    local new_monster = get_monster_pop_factor_value()
    if new_stalker ~= cached_stalker_pop or new_monster ~= cached_monster_pop then
        warfare_log.debug("refresh_pop_cache: pop factors changed stalker=%s monster=%s (was %s/%s)", new_stalker, new_monster, cached_stalker_pop, cached_monster_pop)
        pop_dirty = true
    end
    cached_stalker_pop = new_stalker
    cached_monster_pop = new_monster
end

function get_stalker_pop_factor()
    if not cached_stalker_pop then
        cached_stalker_pop = get_stalker_pop_factor_value()
    end
    return cached_stalker_pop
end

function get_monster_pop_factor_value()
    return ui_options.get("alife/general/alife_mutant_pop")
end

function get_monster_pop_factor()
    if not cached_monster_pop then
        cached_monster_pop = get_monster_pop_factor_value()
    end
    return cached_monster_pop
end

-- for vanilla, probably create a custom simulation.ltx
function fill_start_position()
    warfare_log.info("fill_start_position: entry")

    if (not IsWarfare()) then
        warfare_log.info("fill_start_position: IsWarfare=false, skipping")
        return
    end

    if (SIMBOARD.start_position_filled) then
        warfare_log.debug("fill_start_position: SIMBOARD.start_position_filled already set, skipping")
        return
    end

    SIMBOARD.start_position_filled = true

    if (warfare_options.options.random_starting_locations) then
        warfare_log.info("fill_start_position: random_starting_locations enabled, deferring")
        return
        --initialize_random_starting_locations()
    end

    local setting_ini
    setting_ini = ini_file("misc\\simulation.ltx")

    local stalker_pop_factor = get_stalker_pop_factor()
    local monster_pop_factor = get_monster_pop_factor()

    local result, squad_section, count, li, lc
    -- enemy_new_game_bonus
    local ene_bonus = warfare_options.options.enemy_new_game_bonus
    local actor_faction
    if ene_bonus then
        local config = axr_main.config
        if not (config) then
            warfare_log.warn("fill_start_position: axr_main.config missing, aborting ene_bonus path")
            return
        end
        actor_faction = config:r_value("character_creation", "new_game_faction", 3)
        warfare_log.debug("fill_start_position: ene_bonus actor_faction=%s", actor_faction)
    end

    ignore = sim_offline_combat.get_ignore_list()

    warfare_log.info("fill_start_position: stalker_pop=%s monster_pop=%s speed_mult=%s mutant_max=%s",
        stalker_pop_factor, monster_pop_factor, warfare_options.options.spawn_speed_multiplier or 1,
        warfare_options.options.monster_max_faction_respawn)

    -- mutant spawns on new game + stagger mutant spawn timers
    local speed_mult = warfare_options.options.spawn_speed_multiplier or 1
    local mutant_max = warfare_options.options.monster_max_faction_respawn
    local max_active = warfare_options.options.monster_max_squads_per_level
    for name, smart in pairs(SIMBOARD.smarts_by_names) do

        if not (smart.props) then
            simulation_objects.get_props(smart)
        end

        -- check if level_id is set, if not set it.
        if not (smart.level_id) then
            smart.level_id = game_graph():vertex(smart.m_game_vertex_id):level_id()
        end

        if (smart.props.lair > 0) and (smart.props.base < 1) and (smart.props.resource < 1) and (smart.props.territory < 1) then
            --local mutants_on_level = sim_offline_combat.get_num_squads_on_level(smart.level_id, "monster")

            -- stagger mutant spawn timer so lairs don't all fire at the same time
            smart_terrain_warfare.spawn_mutant_next_update[smart.id] = math.random(0, mutant_max) * speed_mult
            smart_terrain_warfare.spawn_mutant_timers[smart.id] = get_time()

            -- for new game, spawn 50% the allowable mutants, or one mutant squad per smart (whichever occurs first)
            if (math.random(100) < 50 * monster_pop_factor) then
                local current_level = smart.level_id
                local rare_chance = warfare_options.options.monster_rare_chance_south

                if (current_level > 12) and (current_level < 32) then
                    -- levels 13 - 31 include all levels north of military warehouses/dead city/trucks cemetery. Also includes all labs. See level_targets.script for more info
                    if (current_level > 19) and (current_level < 27) then
                        -- labs will spawn scary mutants
                        rare_chance = warfare_options.options.monster_rare_chance_lab
                    else
                        rare_chance = warfare_options.options.monster_rare_chance_north
                    end
                end

                local section = faction_expansions.get_spawn_section("monster", rare_chance, smart.level_id)
                local squad = utils_obj.create_squad(section, smart:name())
                warfare_log.info("fill_start_position: spawned monster section=%s at smart=%s", section, smart:name())
                sim_squad_warfare.set_target(squad, smart.id)

            end
        end
    end

    warfare_log.info("fill_start_position: lair seeding complete, processing simulation.ltx sections")
    setting_ini:section_for_each(function(section)
        lc = setting_ini:line_count(section)
        local smart_current_pop = 0
        for li = 0, lc - 1 do
            local smart = SIMBOARD.smarts_by_names[section]
            if (smart) then
                result, squad_section, count = setting_ini:r_line(section, li, "", "")
                count = tonumber(count) or 1
                if (ignore[squad_section] or not warfare_options.options.random_starting_locations) then
                    local common = ini_sys:r_bool_ex(squad_section, "common")
                    local faction = ini_sys:r_string_ex(squad_section, "faction")
                    if common then

                        -- Common mutants
                        if is_squad_monster[faction] then
                            count = count * monster_pop_factor
                            if (count == 0.5) then
                                count = math.random(0, 1)
                            else
                                count = round_idp(count)
                            end

                            -- Common stalkers
                        else
                            if (stalker_pop_factor > 1) then
                                count = count * stalker_pop_factor                                    -- always spawn all necessary stalkers on game start. Higher factors than 1 can still spawn more
                            end
                            if (count == 0.5) then
                                -- just randomly 0 or 1 instead of always rounding to 1
                                count = math.random(1, 2)
                            else
                                count = round_idp(count)
                            end
                            -- reduce the starting amount of squads from actor's faction and factions neutral to actor's faction and spawn more squads from factions that are enemies with actor's faction(optional)
                            if (ene_bonus and actor_faction) then
                                if (string.find(squad_section, actor_faction) or not warfare.is_squad_section_enemy_of_faction(squad_section, actor_faction)) then
                                    if (count >= 1) then
                                        if (math.random() < 0.5) then
                                            count = count - 1
                                        end
                                    end
                                else
                                    --if (math.random() < 0.5) then
                                    count = count + 1
                                    --end
                                end
                            end
                        end
                    end

                    local sf = get_squad_section_faction(squad_section)

                    if (warfare_options.options.factions[sf].spawn_on_new_game) then
                        for i = 1, count do
                            local squad_spawned = false
                            if smart and (common or string.find(squad_section, "sim_squad_")) and (not is_squad_monster[faction]) and (smart_current_pop < round_idp(math.max(1, smart.max_population * stalker_pop_factor))) then
                                squad = SIMBOARD:create_squad(smart, squad_section)                -- common squads can't go over user-set cap
                                squad_spawned = true
                                smart_current_pop = smart_current_pop + 1
                            elseif ignore[squad_section] or (not string.find(squad_section, "sim_squad_")) then
                                squad = SIMBOARD:create_squad(smart, squad_section)                -- always make story squads
                                squad_spawned = true
                            end

                            if smart and squad_spawned and registered_squads[squad:get_squad_community()] and not ignore[squad:section_name()] then
                                sim_squad_warfare.set_target(squad, smart.id)
                                warfare_log.info("fill_start_position: spawned squad section=%s faction=%s smart=%s", squad_section, sf, smart:name())

                                -- stagger defense/patrol timers for bases so they don't all fire in sync
                                if smart.props and smart.props.base > 0 and not smart_terrain_warfare.defense_timers[smart.id] then
                                    local ff = warfare_options.options.factions[sf]
                                    if ff then
                                        local def_interval = ff.min_faction_respawn * speed_mult
                                        local pat_interval = ff.min_patrol_time * speed_mult
                                        smart_terrain_warfare.defense_timers[smart.id] = warfare_utils.subtract_time(get_time(), math.random(0, math.floor(def_interval * 6)))
                                        smart_terrain_warfare.patrol_timers[smart.id] = warfare_utils.subtract_time(get_time(), math.random(0, math.floor(pat_interval * 6)))
                                        warfare_log.trace("fill_start_position: stagger base smart=%s faction=%s", smart:name(), sf)
                                    end
                                end
                            else
                            end
                        end
                    end
                end
            end
        end
    end)

    warfare_log.info("fill_start_position: complete")
end

-- force squads to target nearest smarts on new warfare game, on_game_load compatibility
function fill_start_position_on_load()
    if alife_storage_manager.get_state().warfare_filled_start_position then
        warfare_log.trace("fill_start_position_on_load: already filled, skipping")
        return
    end
    warfare_log.info("fill_start_position_on_load: retargeting squads to nearest smarts")
    alife_storage_manager.get_state().warfare_filled_start_position = true

    local function get_nearest_smart_id(squad)
        local dist
        local min_dist
        local nearest

        for name, smart in pairs(SIMBOARD.smarts_by_names) do
            local dist = smart.position:distance_to(squad.position)
            if (not min_dist) then
                min_dist = dist
                nearest = smart
            elseif (dist < min_dist) then
                min_dist = dist
                nearest = smart
            end
        end
        if (nearest) then
            if (simulation_objects.is_on_the_same_level(nearest, squad)) then
                return nearest.id
            end
        end
    end

    local retargeted = 0
    for id, v in pairs(SIMBOARD.squads) do
        local squad = alife_object(id)
        local section = squad and squad:section_name()
        if section and registered_squads[squad.player_id] and (not ignore[section]) then
            local smart_id = get_nearest_smart_id(squad)
            if smart_id then
                sim_squad_warfare.set_target(squad, smart_id)
                retargeted = retargeted + 1
            end
        end
    end
    warfare_log.info("fill_start_position_on_load: retargeted %s squads", retargeted)
end

-- When loading a legacy save (pre-1.4.5, detected via missing defense_delay),
-- stagger defense/patrol timers randomly so all bases don't fire their first spawn in the same wave.
-- Mirrors the stagger applied during fill_start_position for new games.
function stagger_legacy_spawn_timers()
    if not legacy_save_stagger then return end
    legacy_save_stagger = false
    warfare_log.info("stagger_legacy_spawn_timers: applying legacy timer stagger")

    local speed_mult = warfare_options.options.spawn_speed_multiplier or 1
    local staggered = 0

    for name, smart in pairs(SIMBOARD.smarts_by_names) do
        if not smart.props then
            simulation_objects.get_props(smart)
        end

        if smart.props and smart.props.base > 0 then
            local faction = smart_terrain_warfare.smart_owners[smart.id] or smart.owning_faction
            if faction and faction ~= "none" then
                local ff = warfare_options.options.factions[faction]
                if ff then
                    local def_interval = ff.min_faction_respawn * speed_mult
                    local pat_interval = ff.min_patrol_time * speed_mult
                    smart_terrain_warfare.defense_timers[smart.id] = warfare_utils.subtract_time(get_time(), math.random(0, math.floor(def_interval * 6)))
                    smart_terrain_warfare.patrol_timers[smart.id] = warfare_utils.subtract_time(get_time(), math.random(0, math.floor(pat_interval * 6)))
                    staggered = staggered + 1
                end
            end
        end
    end
    warfare_log.info("stagger_legacy_spawn_timers: staggered %s bases", staggered)
end

function initialize_random_starting_locations()
    warfare_log.info("initialize_random_starting_locations: entry")
    local bases = {}
    local max_resources = 0
    for _, smart in pairs(SIMBOARD.smarts_by_names) do

        if not (smart.props) then
            simulation_objects.get_props(smart)
        end

        if (smart.props and smart.props.resource) then
            max_resources = max_resources + smart.props.resource
        end

        if (smart.props and smart.props.base > 0) then
            bases[#bases + 1] = smart
        end
    end

    local base = bases[math.random(#bases)]
    warfare_log.info("initialize_random_starting_locations: chosen base=%s for actor faction", base and base:name())

    start_pos = {}
    table.insert(start_pos, base.m_level_vertex_id)
    table.insert(start_pos, base.m_game_vertex_id)
    table.insert(start_pos, base.position)

    local id = smart_terrain.nearest_to_actor_smart.id
    local starting_smarts = {}
    local used_smarts = {}

    actor_faction = alife():actor():community():sub(7)
    warfare_log.debug("initialize_random_starting_locations: actor_faction=%s", actor_faction)

    starting_smarts[actor_faction] = {
        smart = base,
        p = global_position.from(base)
    }

    used_smarts[base.id] = true
    local resources = math.random(max_resources) --warfare_factions.faction_information[actor_faction].resource_count
    local section = faction_expansions.get_spawn_section(actor_faction, resources, max_resources)

    local squad = utils_obj.create_squad(section, base:name())
    sim_squad_warfare.set_target(squad, base.id)

    for _, f in pairs(warfare_factions.factions) do
        if (f ~= actor_faction and warfare_options.options.factions[f].spawn_on_new_game) then
            local smarts = SIMBOARD.smarts_by_names
            local smarts2 = hash_table_to_array(smarts)
            shuffleTable(smarts2)

            for __, t in pairs(smarts2) do
                local s = t.value
                local lvl = game_graph():vertex(s.m_game_vertex_id):level_id()
                local off = level_targets.level_offsets[lvl]

                if (off and s.props and s.props.base > 0) then
                    local gpos = global_position.from(s)
                    local safe = true

                    for f2, t2 in pairs(starting_smarts) do
                        local dist = gpos:distance_to_sqr(t2.p)

                        if (dist < 160000) then
                            safe = false
                        end
                    end

                    if (safe) then
                        warfare_log.info("initialize_random_starting_locations: assigned faction=%s to base=%s", f, s:name())
                        starting_smarts[f] = { smart = s, p = gpos, }
                        used_smarts[s.id] = true
                        s.global_position = gpos

                        local section = faction_expansions.get_spawn_section(f, math.random(max_resources), max_resources)
                        local squad = utils_obj.create_squad(section, s:name())
                        sim_squad_warfare.set_target(squad, s.id)

                        break
                    end
                end
            end
        end
    end

    for name, smart in pairs(SIMBOARD.smarts_by_names) do
        if (smart.props) then
            if (smart.props.base > 0) then
                if not (used_smarts[smart.id]) then
                    local f = {}

                    for _, faction in pairs(warfare_factions.factions) do
                        if (warfare_options.options.factions[faction].spawn_on_new_game) then
                            local flag = smart.props[faction] or 0
                            local entries = warfare_options.options.factions[faction].random_spawn_entries

                            if (entries > 0) then
                                for i = 0, entries do
                                    f[#f + 1] = faction
                                end
                            end

                            if (flag > 0) then
                                f[#f + 1] = faction
                            end
                        end
                    end

                    if (#f > 0) then
                        f = f[math.random(#f)]

                        if (math.random(100) <= warfare_options.options.random_stalker_chance) then
                            local section = faction_expansions.get_spawn_section(f, math.random(max_resources), max_resources)
                            local squad = utils_obj.create_squad(section, smart:name())
                            sim_squad_warfare.set_target(squad, smart.id)
                        end
                    end
                end
            elseif (smart.props.resource > 0) then
                local f = {}

                for _, faction in pairs(warfare_factions.factions) do
                    local flag = smart.props[faction] or 0

                    if (warfare_options.options.factions[faction].spawn_on_new_game) then
                        local flag = smart.props[faction] or 0
                        local entries = warfare_options.options.factions[faction].random_spawn_entries

                        if (entries > 0) then
                            for i = 0, entries do
                                f[#f + 1] = faction
                            end
                        end

                        if (flag > 0) then
                            f[#f + 1] = faction
                        end
                    end
                end

                if (#f > 0) then
                    f = f[math.random(#f)]

                    if (math.random(100) <= warfare_options.options.random_stalker_chance) then
                        local section = faction_expansions.get_spawn_section(f, math.random(max_resources), max_resources)
                        local squad = utils_obj.create_squad(section, smart:name())
                        sim_squad_warfare.set_target(squad, smart.id)
                    end
                end
            elseif (smart.props.lair > 0) then
                if (math.random(100) <= warfare_options.options.random_monster_chance) then
                    local section = faction_expansions.get_spawn_section("monster", math.random(max_resources), max_resources)
                    local squad = utils_obj.create_squad(section, smart:name())
                    sim_squad_warfare.set_target(squad, smart.id)
                end
            end
        end
    end

    warfare_log.info("initialize_random_starting_locations: complete, calling ChangeLevel")
    ChangeLevel(start_pos[3], start_pos[1], start_pos[2], VEC_ZERO)

end

-- linear interpolation function
function lerp(a, b, f)
    if (a and b and f) then
        return (1 - f) * a + (f * b)
    else
        return a or b or 0
    end
end

function squad_on_unregister(squad, type_name)
    if (type_name ~= "sim_squad_scripted") then
        return
    end

    if (squad) then
        local faction = squad:get_squad_community()
        warfare_log.debug("squad_on_unregister: squad=%s id=%s faction=%s", squad:name(), squad.id, faction)

        if (registered_squads[faction]) then
            remove_registered_squad(faction, squad.id)

            if (smart_terrain_warfare.random_patrols[squad.id]) then
                warfare_log.trace("squad_on_unregister: dropping random_patrol id=%s", squad.id)
                smart_terrain_warfare.remove_random_patrol(squad.id)
            end

            if (squad.patrol_owner) then
                warfare_log.trace("squad_on_unregister: dropping patrol_squads[%s][%s]", squad.patrol_owner, squad.id)
                smart_terrain_warfare.patrol_squads[squad.patrol_owner][squad.id] = nil
            end
        else
            warfare_log.trace("squad_on_unregister: faction %s not registered, ignoring", faction)
        end
    end
end

function on_game_start()
    warfare_log.info("on_game_start: registering warfare callbacks")
    --_G.WARFARE = false
    warfare_options.update_settings()

    RegisterScriptCallback("fill_start_position", fill_start_position)
    RegisterScriptCallback("load_state", load_state)
    _G.WARFARE = true
    RegisterScriptCallback("smart_terrain_on_update", smart_terrain_warfare.smart_terrain_on_update)
    RegisterScriptCallback("squad_on_update", sim_squad_warfare.squad_on_update)
    RegisterScriptCallback("actor_on_update", actor_on_update)
    RegisterScriptCallback("save_state", save_state)
    RegisterScriptCallback("squad_on_npc_death", sim_squad_warfare.squad_on_npc_death)
    RegisterScriptCallback("server_entity_on_unregister", squad_on_unregister)
    RegisterScriptCallback("actor_on_first_update", actor_on_first_update)

    local function on_game_load()
        warfare_log.info("on_game_load: priming ignore list and scheduling resetter")
        ignore = sim_offline_combat.get_ignore_list()
        stagger_legacy_spawn_timers()
        CreateTimeEvent(0, "reset_warfare_callbacks", 60, resetter)
    end
    RegisterScriptCallback("on_game_load", on_game_load)
end

function hash_table_to_array(tbl)
    local r = {}

    for k, v in pairs(tbl) do
        r[#r + 1] = { key = k, value = v }
    end

    return r
end


function distance_to_xz_sqr(a, b)
    return math.pow(b.x - a.x, 2) + math.pow(b.z - a.z, 2)
end

function is_warfare_trader(npc)
    -- used by task managers
    if string.find(npc:name(), "sim_default_%a+_trader") or
            string.find(npc:name(), "sim_default_%a+_mechanic") or
            string.find(npc:name(), "sim_default_%a+_medic") or
            string.find(npc:name(), "sim_default_%a+_barman") then
        return true
    else
        return false
    end
end

function get_squad_section_faction(squad_section)
    if string.find(squad_section, "stalker") then
        return "stalker"
    elseif string.find(squad_section, "bandit") then
        return "bandit"
    elseif string.find(squad_section, "csky") then
        return "csky"
    elseif string.find(squad_section, "army") or string.find(squad_section, "military") then
        return "army"
    elseif string.find(squad_section, "freedom") then
        return "freedom"
    elseif string.find(squad_section, "duty") or string.find(squad_section, "dolg") then
        return "dolg"
    elseif string.find(squad_section, "ecolog") then
        return "ecolog"
    elseif string.find(squad_section, "merc") or string.find(squad_section, "killer") then
        return "killer"
    elseif string.find(squad_section, "monolith") then
        return "monolith"
    elseif string.find(squad_section, "renegade") then
        return "renegade"
    elseif string.find(squad_section, "greh") then
        return "greh"
    elseif string.find(squad_section, "isg") then
        return "isg"
    elseif string.find(squad_section, "zombied") then
        return "zombied"
    else
        return "stalker"
    end
end

function is_squad_section_enemy_of_faction(squad_section, faction)
    if not faction then
        faction = db.actor and character_community(db.actor) --:sub(7)
    end
    if string.find(squad_section, "stalker") then
        return game_relations.is_factions_enemies("stalker", faction)
    elseif string.find(squad_section, "bandit") then
        return game_relations.is_factions_enemies("bandit", faction)
    elseif string.find(squad_section, "csky") then
        return game_relations.is_factions_enemies("csky", faction)
    elseif string.find(squad_section, "army") or string.find(squad_section, "military") then
        return game_relations.is_factions_enemies("army", faction)
    elseif string.find(squad_section, "freedom") then
        return game_relations.is_factions_enemies("freedom", faction)
    elseif string.find(squad_section, "duty") or string.find(squad_section, "dolg") then
        return game_relations.is_factions_enemies("dolg", faction)
    elseif string.find(squad_section, "ecolog") then
        return game_relations.is_factions_enemies("ecolog", faction)
    elseif string.find(squad_section, "merc") or string.find(squad_section, "killer") then
        return game_relations.is_factions_enemies("killer", faction)
    elseif string.find(squad_section, "monolith") then
        return game_relations.is_factions_enemies("monolith", faction)
    elseif string.find(squad_section, "renegade") then
        return game_relations.is_factions_enemies("renegade", faction)
    elseif string.find(squad_section, "greh") then
        return game_relations.is_factions_enemies("greh", faction)
    elseif string.find(squad_section, "isg") then
        return game_relations.is_factions_enemies("isg", faction)
    elseif string.find(squad_section, "zombied") then
        return game_relations.is_factions_enemies("zombied", faction)
    else
        return true
    end
end

local function get_zombied_section(original_section)
    if string.find(original_section, "_veteran") then
        return "zombied_sim_squad_veteran"
    elseif string.find(original_section, "_advanced") then
        return "zombied_sim_squad_advanced"
    end
    return "zombied_sim_squad_novice"
end

function snap()
    local mode = warfare_options.options.emission_effect
    if (not mode) or (mode == "off") then
        warfare_log.debug("snap: emission_effect disabled, returning")
        return
    end

    local p = warfare_options.options.purge_zone_percentage or 5
    warfare_log.info("snap: emission purge mode=%s percentage=%s", mode, p)

    -- Collect all squad IDs first — modifying registered_squads during pairs() is unsafe
    local to_process = {}
    for faction, tbl in pairs(registered_squads) do
        for squad_id, _ in pairs(tbl) do
            to_process[#to_process + 1] = { id = squad_id, faction = faction }
        end
    end
    warfare_log.debug("snap: collected %s candidate squads", #to_process)

    local zombified = 0
    local killed = 0
    for _, entry in ipairs(to_process) do
        local squad = alife_object(entry.id)
        local faction = entry.faction

        if squad and (math.random(100) <= p) then
            -- Skip squads defending a protected main base still held by their faction
            if warfare_options and warfare_options.options.prevent_mainbase_attacks then
                local target_id = squad.current_target_id
                local target = target_id and alife_object(target_id)
                if target and target.owning_faction == faction then
                    local t_name = target.name and target:name()
                    if t_name and smart_terrain_warfare.get_protected_base_faction(t_name) == faction then
                        warfare_log.trace("snap: skip protected base defender squad=%s smart=%s", squad:name(), t_name)
                        goto continue
                    end
                end
            end

            if mode == "zombify" and faction ~= "zombied" and faction ~= "monster" then
                local original_count = squad:npc_count()
                local original_section = squad:section_name()
                local smart_id = squad.current_target_id or squad.smart_id
                local smart_obj = smart_id and alife_object(smart_id)
                local smart_name = smart_obj and smart_obj:name()

                sim_squad_warfare.remove_squad(squad)
                squad:remove_squad()

                -- Spawn zombied replacement as random patrol
                if smart_name and original_count > 0 then
                    local section = get_zombied_section(original_section)
                    local new_squad = utils_obj.create_squad(section, smart_name)
                    if new_squad then
                        warfare_log.trace("snap: zombified squad section=%s->%s smart=%s count=%s", original_section, section, smart_name, original_count)
                        -- Trim zombie squad down to original member count
                        local excess = new_squad:npc_count() - original_count
                        if excess > 0 then
                            local remove_list = {}
                            for k in new_squad:squad_members() do
                                if #remove_list >= excess then break end
                                if k.id ~= new_squad:commander_id() then
                                    remove_list[#remove_list + 1] = k.id
                                end
                            end
                            for _, npc_id in ipairs(remove_list) do
                                new_squad:remove_npc(npc_id, true)
                            end
                        end
                        -- Register as random patrol
                        smart_terrain_warfare.set_random_patrol(new_squad.id, "zombied")
                        local patrol_target = smart_terrain_warfare.find_random_patrol_target(smart_obj, "zombied", new_squad.id)
                        if patrol_target then
                            sim_squad_warfare.set_target(new_squad, patrol_target)
                        else
                            warfare_log.warn("snap: zombified squad %s has no patrol_target", new_squad:name())
                        end
                        zombified = zombified + 1
                    else
                        warfare_log.warn("snap: failed to spawn zombified replacement section=%s smart=%s", section, smart_name)
                    end
                end
            else
                -- Kill mode (or zombify skips zombie/monster squads — just kill them)
                warfare_log.trace("snap: kill squad=%s faction=%s", squad:name(), faction)
                sim_squad_warfare.remove_squad(squad)
                squad:remove_squad()
                killed = killed + 1
            end

            ::continue::
        end
    end
    warfare_log.info("snap: complete zombified=%s killed=%s", zombified, killed)
end

function resetter()
    if not (IsWarfare()) then
        warfare_log.info("resetter: IsWarfare=false, unregistering warfare callbacks")
        _G.WARFARE = false
        UnregisterScriptCallback("fill_start_position", fill_start_position)
        UnregisterScriptCallback("load_state", load_state)
        UnregisterScriptCallback("smart_terrain_on_update", smart_terrain_warfare.smart_terrain_on_update)
        UnregisterScriptCallback("squad_on_update", sim_squad_warfare.squad_on_update)
        UnregisterScriptCallback("actor_on_update", actor_on_update)
        UnregisterScriptCallback("save_state", save_state)
        UnregisterScriptCallback("squad_on_npc_death", sim_squad_warfare.squad_on_npc_death)
        UnregisterScriptCallback("server_entity_on_unregister", squad_on_unregister)
        UnregisterScriptCallback("actor_on_first_update", actor_on_first_update)
    end
    return true
end

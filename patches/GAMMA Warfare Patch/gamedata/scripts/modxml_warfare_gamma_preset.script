-- GAMMA's text overhaul sets ui_mm_preset to "(DON'T USE)" to discourage the
-- difficulty-preset dropdowns. Warfare's presets are real, so relabel the shared
-- options caption to a usable string only while a warfare preset tree is open;
-- every other preset page falls back to ui_mm_preset and keeps GAMMA's text.
-- Must be a modxml_ script: DXML force-loads these at engine init, so the wrapper
-- is installed before the main-menu Options screen is built. The warfare gameplay
-- scripts only load once in-game, which is too late for the main menu.

local ui_options_UIOptions_register_preset = ui_options.UIOptions.Register_Preset
function ui_options.UIOptions.Register_Preset(self, ct)
    ui_options_UIOptions_register_preset(self, ct)
    if ct.presets and self.preset_cap then
        local is_warfare = tostring(ct.presets[1]):find("^warfare") ~= nil
        self.preset_cap:TextControl():SetText(game.translate_string(is_warfare and "ui_warfare_preset" or "ui_mm_preset"))
    end
end
